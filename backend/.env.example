# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (MongoDB)
# Local example: mongodb://127.0.0.1:27017/trustlens
# Atlas example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/trustlens
MONGO_URI=mongodb://127.0.0.1:27017/trustlens

# Security / JWT Secret Key
JWT_SECRET=your_super_secret_jwt_key_here

# Optional Gemini multimodal explanation provider
AI_PROVIDER=gemini
AI_API_KEY=
AI_MODEL=
# Optional Gemini API base URL; normally leave blank for Google's public API
AI_API_URL=
AI_TIMEOUT_MS=120000
GEMINI_FILE_PROCESSING_TIMEOUT_MS=300000
